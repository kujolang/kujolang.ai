+.home-explorer .example-selector[hidden] { display: none; }
+.home-explorer .example-selector label { font-size: .8rem; }
+.home-explorer .example-panel { padding: 1.5rem; border: 1px solid var(--home-line); border-top: 0; background: #f7f7f3; margin-bottom: 1.5rem; }
+.home-explorer .example-panel h3 { margin-bottom: .5rem; }
+.home-explorer .example-panel .eyebrow { margin-bottom: .5rem; }
+.home-explorer .example-panel > p:last-child { font-size: .75rem; margin-top: 1.25rem; }
