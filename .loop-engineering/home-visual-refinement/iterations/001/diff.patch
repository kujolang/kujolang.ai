+.home-section-heading, .home-explorer-heading { display: flex; justify-content: space-between; gap: 2rem; align-items: end; margin-bottom: 2rem; }
+.home-section-heading > p { max-width: 38ch; }
+.home-section-heading h2, .home-explorer-heading h2 { margin-bottom: 0; }
+.language-home > .home-explorer { padding-block: 1.75rem 3rem; }
