+.home-card-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); border: 1px solid var(--home-line); }
+.home-card { padding: 2rem; display: flex; flex-direction: column; gap: 1rem; border-right: 1px solid var(--home-line); }
+.home-card:last-child { border: 0; }
+.home-card-mark { font-size: 2.5rem; letter-spacing: -.08em; padding-bottom: 1.5rem; }
+.home-card p { margin: 0 0 1rem; }
+.home-card a { margin-top: auto; font-size: .8rem; }
+.home-runtime { background: #171717; color: #f6f6f2; }
+.home-runtime-inner { max-width: 1280px; margin-inline: auto; padding: clamp(3rem,6vw,5rem) var(--site-pad-inline); display: grid; grid-template-columns: 1fr 1fr; gap: 2rem 5rem; }
+.home-runtime h2 { font-size: clamp(2rem,3.4vw,3.5rem); line-height: 1.15; margin: 1rem 0 1.5rem; }
+.home-runtime p { color: #ccc; line-height: 1.7; }
+.home-runtime a { color: #fff; font-size: .8rem; }
+.home-runtime header > a { display: inline-block; margin-top: 1.5rem; }
+.home-runtime code { color: #fff; background: transparent; overflow-wrap: anywhere; }
+.home-runtime-steps article { display: grid; grid-template-columns: 2rem 1fr; gap: 1rem; border-top: 1px solid #555; padding: 1.5rem 0; }
+.home-runtime-steps article > span { font-size: .7rem; color: #bbb; padding-top: .3rem; }
+.home-runtime-steps h3 { margin: 0 0 .5rem; }
+.home-runtime-steps p { margin-bottom: .75rem; }
+.home-runtime-note { grid-column: 1/-1; border-top: 1px solid #555; padding-top: 1.5rem; font-size: .75rem !important; }
+.home-start { display: grid; grid-template-columns: 1fr 1.5fr; gap: 4rem; align-items: start; }
+.home-start header > p:not(.eyebrow) { max-width: 30ch; margin-bottom: 1.5rem; }
+.home-start header > a { font-size: .8rem; }
+.home-start h2 { font-size: clamp(2.8rem,5vw,4.5rem); }
+.home-terminal { border: 1px solid var(--home-line); background: #f0f0eb; padding: 0 1.5rem 1rem; min-width: 0; }
+.home-terminal-bar { display: flex; justify-content: space-between; gap: 1rem; border-bottom: 1px solid var(--home-line); padding-block: 1rem; font-size: .7rem; margin-bottom: 1.5rem; }
+.home-terminal > p { font-size: .75rem; }
+.home-terminal .sample-code { margin-bottom: 1.5rem; }
+.home-terminal .sample-code pre { border-radius: 0; font-size: .78rem; }
+.home-terminal-result { border-top: 1px solid var(--home-line); padding-top: 1rem; }
+.home-ecosystem { background: #f4f4ef; }
+.home-tool-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); border-top: 1px solid var(--home-line); border-left: 1px solid var(--home-line); }
+.home-tool-grid > a { padding: 1.5rem; border-right: 1px solid var(--home-line); border-bottom: 1px solid var(--home-line); text-decoration: none; display: grid; gap: 1.25rem; }
+.home-tool-grid > a:hover { background: #e6e6df; }
+.home-tool-grid > a > span { font-size: .7rem; }
+.home-tool-grid strong { font-size: 1.3rem; display: flex; justify-content: space-between; gap: .5rem; }
+.home-link-row { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; margin-top: 2rem; font-size: .8rem; }
+.home-proof { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; }
+.home-proof header > p:not(.eyebrow) { max-width: 40ch; margin-bottom: 1.5rem; }
+.home-proof header > a { font-size: .8rem; }
+.home-proof-links a { display: grid; grid-template-columns: 2rem 1fr 1rem; gap: 1rem; align-items: center; padding: 1.75rem 0; border-top: 1px solid var(--home-line); text-decoration: none; }
+.home-proof-links a:last-child { border-bottom: 1px solid var(--home-line); }
+.home-proof-links a > span { font-size: .75rem; }
+.home-proof-links a:hover strong { text-decoration: underline; text-underline-offset: .25em; }
+.language-home > .language-final { text-align: center; border-top: 1px solid var(--home-line); }
+.language-final p { margin-inline: auto; margin-bottom: 1.5rem; }
+.language-final h2 { font-size: clamp(2.4rem,5vw,4.5rem); }
+@media(max-width: 800px) {
+ .home-card-grid { grid-template-columns: 1fr; }
+ .home-card { border-right: 0; border-bottom: 1px solid var(--home-line); padding: 1.5rem; }
+ .home-card-mark { padding-bottom: .5rem; }
+ .home-runtime-inner, .home-start, .home-proof { grid-template-columns: 1fr; gap: 2rem; }
+ .home-tool-grid { grid-template-columns: repeat(2,minmax(0,1fr)); }
+ .home-start h2 br { display: none; }
+ .home-section-heading { display: block; }
+ .home-section-heading > p { margin-top: 1rem; }
+}
+@media(max-width: 480px) {
+ .home-explorer-heading { display: block; }
+ .home-explorer-heading > a { display: inline-block; margin-top: 1rem; }
+ .home-explorer .example-selector { display: block; padding: 1rem; }
+ .home-explorer .example-selector label { margin-bottom: .5rem; }
+ .home-explorer .example-selector select { width: 100%; font-size: .8rem; }
+ .home-explorer .example-panel { padding: 1rem; }
+ .home-tool-grid { grid-template-columns: 1fr; }
+ .home-terminal { padding-inline: 1rem; }
+ .home-proof-links strong { font-size: .9rem; }
+}
