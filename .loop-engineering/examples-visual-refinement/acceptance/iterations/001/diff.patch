+}
+.sample-code .syntax-token { font-weight: 400; }
+.sample-code .syntax-keyword { color: #b8bcff; font-weight: 600; }
+.sample-code .syntax-string { color: #b8dfa4; }
+.sample-code .syntax-comment { color: #a8afb9; }
