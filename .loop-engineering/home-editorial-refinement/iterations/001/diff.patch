+@media(max-width:760px) {
+ .language-home .home-hero .sk-hero__inner { min-block-size: auto; padding-block: calc(var(--site-header-block) + 4rem) 4rem; }
+ .language-home .home-hero h1 { font-size: clamp(3rem,8vw,4.5rem); }
+ .language-home .home-hero .home-hero__body { font-size: 1rem; }
+ .home-tool-grid strong { font-size: 1.3rem; }
+}
+/* A fixed side gutter keeps the absolute copy control off the first code line. */
+:is(.language-home,.examples-site) .sample-code { background: #181818; color: #f9f9f9; border-radius: 0; }
+:is(.language-home,.examples-site) .sample-code pre {
+ width: calc(100% - 3.5rem);
+ max-width: calc(100% - 3.5rem);
+ min-height: 4rem;
+ padding: 1.25rem;
+ border-radius: 0;
+}
+:is(.language-home,.examples-site) [data-code-status]:not(:empty) {
+ top: .9rem;
+ right: 3.75rem;
+ padding: 0;
+ border: 0;
+ background: transparent;
+ color: #fff;
+ font-size: .75rem;
+ pointer-events: none;
+}
+@media(max-width:480px) {
+ :is(.language-home,.examples-site) .sample-code pre { padding: 1rem; }
+}
