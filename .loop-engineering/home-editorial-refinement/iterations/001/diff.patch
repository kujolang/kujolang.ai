+.home-build .home-section-heading,.home-ecosystem .home-section-heading { display: block; text-align: center; margin-bottom: 2.5rem; }
+.home-runtime-note { text-align: center; }
+.home-start h2 { font-size: clamp(2.6rem,4.4vw,4rem); line-height: 1.2; }
+.home-ecosystem { background: transparent; }
+.language-home > .language-final {
+ max-width: none;
+ max-inline-size: none;
+ padding-inline: 0;
+ padding-block: clamp(4rem,7vw,7rem);
