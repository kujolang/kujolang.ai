+ width: 100%;
+ max-width: var(--home-content-width);
+ max-inline-size: var(--home-content-width);
+ margin-inline: auto;
+ padding-inline: var(--site-pad-inline);
+}
+.language-home .home-hero .sk-hero__inner {
+ min-block-size: min(860px,88svh);
+ padding-block: calc(var(--site-header-block) + clamp(4rem,7vw,7rem)) clamp(4rem,7vw,7rem);
+}
+.language-home .home-hero h1 { font-size: clamp(3.2rem,6.2vw,6rem); max-inline-size: 14ch; }
+.language-home .home-hero .home-hero__body { font-size: 1.1rem; max-inline-size: 52ch; margin-top: 1.75rem; }
