diff --git a/assets/css/style.css b/assets/css/style.css
index 1eb84ee..ca87a0e 100644
--- a/assets/css/style.css
+++ b/assets/css/style.css
@@ -2026,3 +2026,24 @@ pre, pre code, .sample-code pre, .sample-code code {
  font-size: .75rem; line-height: 1.4; pointer-events: none;
  transition: none !important; animation: none !important;
 }
+
+/* Complete AI applications sit above the language reference samples. */
+.workflow-collection { margin: 0 0 4rem; padding: 3rem 0; border-block: 1px solid var(--example-line); }
+.workflow-collection > header { max-width: 46rem; margin-bottom: 2rem; }
+.workflow-collection h2, .workflow-section h2, .workflow-overview h2 { font-family: var(--sk-font-mono); margin-bottom: 1rem; }
+.workflow-card { display: flex; flex-direction: column; align-items: flex-start; gap: 1rem; padding: 1.5rem; background: #fff; border: 1px solid var(--example-line); }
+.workflow-card h3 { font-family: var(--sk-font-mono); font-size: 1.15rem; line-height: 1.5; }
+.workflow-card p { line-height: 1.7; }
+.workflow-card .example-card-file { margin-top: auto; }
+.workflow-bundle-link { display: inline-block; margin-top: 2rem; }
+.workflow-overview { display: grid; grid-template-columns: 2fr 1fr; gap: 2rem; margin-bottom: 3rem; padding: 2rem; background: #161616; color: #fff; }
+.workflow-overview strong { font-family: var(--sk-font-mono); overflow-wrap: anywhere; }
+.workflow-overview p { line-height: 1.7; }
+.workflow-section { padding-block: 3rem; border-bottom: 1px solid var(--example-line); }
+.workflow-section > p { max-width: 56rem; margin-bottom: 1.5rem; line-height: 1.8; }
+.workflow-section h3 { font-family: var(--sk-font-mono); margin: 2rem 0 1rem; }
+.workflow-steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; padding-left: 1.5rem; line-height: 1.8; }
+.workflow-failure { border-left: 4px solid #171717; padding-left: 2rem; }
+@media(max-width: 700px) { .workflow-overview, .workflow-steps { grid-template-columns: 1fr; } .workflow-overview { padding: 1.5rem; } .workflow-failure { padding-left: 1rem; } }
+.workflow-overview .eyebrow { color: #ccc; }
+.workflow-collection { scroll-margin-top: 8rem; }
