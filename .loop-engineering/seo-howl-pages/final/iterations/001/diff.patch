+<script type="application/ld+json">{"@context":"https://schema.org","@type":"SoftwareSourceCode","@id":"https://kujolang.ai/examples/files/#source","name":"File operations","description":"Explore file operations.","codeRepository":"https://github.com/kujolang/kujo","programmingLanguage":"Kujo","codeSampleType":"code snippet","url":"https://kujolang.ai/examples/files/","text":"# File Operations Demo\n# Demonstrates file operation helpers with local output helpers.\n\nfunc section(title) {\n    print(\"\")\n    print(\"== \" + title + \" ==\")\n}\n\nfunc kv(label, value) {\n    print(\"  \" + label + \": \" + to_string(value))\n}\n\nfunc ok(message) {\n    print(\"  ✓ \" + message)\n}\n\nsection(\"File Operations Demo\")\n\n# Create a test file\nsection(\"1. Creating test file\")\nwrite_file(\"demo_test.txt\", \"Hello, Kujo!\\nThis is a test file.\\n\")\nok(\"Created demo_test.txt\")\n\n# Check file size\nsection(\"2. Checking file size\")\nsize := file_size(\"demo_test.txt\")\nkv(\"File size\", \"${size} bytes\")\n\n# Copy the file\nsection(\"3. Copying file\")\ncopy_file(\"demo_test.txt\", \"demo_test_copy.txt\")\nok(\"Copied to demo_test_copy.txt\")\n\n# Verify both files exist\nsection(\"4. Verifying both files exist\")\nexists1 := file_exists(\"demo_test.txt\")\nexists2 := file_exists(\"demo_test_copy.txt\")\nkv(\"Original exists\", exists1)\nkv(\"Copy exists\", exists2)\n\n# Check sizes match\nsection(\"5. Comparing file sizes\")\nsize1 := file_size(\"demo_test.txt\")\nsize2 := file_size(\"demo_test_copy.txt\")\nif size1 == size2 {\n    ok(\"Sizes match: ${size1} bytes\")\n} else {\n    print(\"   ✗ Size mismatch!\")\n}\n\n# Rename the original\nsection(\"6. Renaming original file\")\nrename_file(\"demo_test.txt\", \"demo_renamed.txt\")\nok(\"Renamed to demo_renamed.txt\")\n\n# List current directory to see files\nsection(\"7. Files in current directory\")\nfiles := list_dir(\".\")\nfor file in files {\n    if contains(file, \"demo_\") {\n        print(\"   - ${file}\")\n    }\n}\n\n# Clean up\nsection(\"8. Cleaning up\")\ndelete_file(\"demo_renamed.txt\")\ndelete_file(\"demo_test_copy.txt\")\nok(\"Deleted all test files\")\n\n# Verify cleanup\nsection(\"9. Verification\")\ncheck1 := file_exists(\"demo_test.txt\")\ncheck2 := file_exists(\"demo_test_copy.txt\")\ncheck3 := file_exists(\"demo_renamed.txt\")\n\nif !check1 && !check2 && !check3 {\n    ok(\"All files successfully removed\")\n} else {\n    print(\"   ✗ Some files still exist\")\n}\n\nsection(\"Demo Complete\")\n\n# Practical example: Backup system\nsection(\"Practical Example: Simple Backup\")\n\n# Create a config file\nconfig := \"database_host=localhost\\ndatabase_port=5432\\n\"\nwrite_file(\"app_config.txt\", config)\nok(\"Created app_config.txt (${len(config)} bytes)\")\n\n# Create backup\nif file_exists(\"app_config.txt\") {\n    copy_file(\"app_config.txt\", \"app_config.backup.txt\")\n    size := file_size(\"app_config.backup.txt\")\n    ok(\"Backup created: app_config.backup.txt (${size} bytes)\")\n}\n\n# Modify the config\nnew_config := \"database_host=prod-server\\ndatabase_port=5432\\n\"\nwrite_file(\"app_config.txt\", new_config)\nok(\"Modified app_config.txt\")\n\n# Compare sizes\noriginal_size := file_size(\"app_config.txt\")\nbackup_size := file_size(\"app_config.backup.txt\")\nkv(\"Original bytes\", original_size)\nkv(\"Backup bytes\", backup_size)\n\n# Cleanup\ndelete_file(\"app_config.txt\")\ndelete_file(\"app_config.backup.txt\")\nok(\"Cleanup complete\")\n","isBasedOn":"https://github.com/kujolang/kujo/blob/2cfaf185ad03059c89ef4f72fb061074255d00fc/examples/file_operations_demo.kujo"}</script>
