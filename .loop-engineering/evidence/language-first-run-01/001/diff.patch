+.sample-code pre, .example-panel pre { background: #181818; color: #f9f9f9; padding: 1.2rem; border-radius: 4px; overflow-x: auto; max-width: 100%; font-size: .88rem; line-height: 1.65; }
+.sample-code code { color: inherit; background: transparent; white-space: pre; }
+.syntax-token { color: #fff; font-weight: 700; text-decoration-color: #777; }
+.sample-code button { margin-right: 1rem; min-height: 44px; }
+.example-panel[hidden], [data-example-card][hidden], .example-category-group[hidden] { display: none !important; }
+.example-selector, .example-filter { margin-block: 1.5rem; }
+.example-selector select, .example-filter input, .example-filter select { font: inherit; padding: .7rem; border: 1px solid #777; color: #111; background: #fff; max-width: 100%; min-height: 44px; }
+.example-filter label { display: block; margin-top: 1rem; }
+.example-note { border-left: 3px solid #777; padding-left: 1rem; }
+.example-category-group { border-bottom: 1px solid #ccc; padding-block: 1rem; }
+.workflow-stages { display: flex; flex-wrap: wrap; gap: 1rem 2rem; padding-left: 1.5rem; }
+.workflow-stages li { flex: 1 1 140px; }
+.language-final { padding-bottom: 4rem; }
+.language-final .sk-button { margin: .5rem; }
+:focus-visible { outline: 3px solid #555; outline-offset: 4px; }
+@media(max-width: 700px) { .language-home .home-hero .sk-hero__inner { padding-block: calc(var(--site-header-block) + 1.5rem) 1rem; } .language-section { padding-block: 2rem; } .example-selector label { display: block; } }
diff --git a/assets/js/site.js b/assets/js/site.js
index 93628d8..66c0bf0 100644
--- a/assets/js/site.js
+++ b/assets/js/site.js
@@ -613,3 +613,43 @@
     init();
   }
 })();
+
+// Native controls progressively enhance static, indexable language examples.
+(() => {
+  document.querySelectorAll('[data-code-explorer]').forEach(root => {
+    const selector = root.querySelector('select');
+    const panels = [...root.querySelectorAll('[data-example]')];
+    const update = () => panels.forEach(panel => { panel.hidden = panel.dataset.example !== selector.value; });
+    root.querySelector('.example-selector').hidden = false;
+    selector.addEventListener('change', update);
+    update();
+  });
+  document.querySelectorAll('[data-copy-code]').forEach(button => {
+    button.hidden = false;
+    button.addEventListener('click', async () => {
+      const root = button.closest('.sample-code');
+      const status = root.querySelector('[data-code-status]');
+      try {
+        await navigator.clipboard.writeText(root.querySelector('code').textContent);
+        status.textContent = 'Copied!';
+      } catch {
+        status.textContent = 'Copy unavailable. Select the code and copy it manually.';
+      }
+    });
+  });
+  const search = document.querySelector('#example-search');
+  const category = document.querySelector('#example-category');
+  if (search && category) {
+    document.querySelector('.example-filter').hidden = false;
+    const cards = [...document.querySelectorAll('[data-example-card]')];
+    const update = () => {
+      const query = search.value.trim().toLowerCase();
+      cards.forEach(card => { card.hidden = !card.textContent.toLowerCase().includes(query) || (category.value !== '' && card.dataset.category !== category.value); });
+      document.querySelectorAll('.example-category-group').forEach(group => { group.hidden = [...group.querySelectorAll('[data-example-card]')].every(card => card.hidden); });
+      document.querySelector('#example-count').textContent = `${cards.filter(card => !card.hidden).length} examples found`;
+    };
+    search.addEventListener('input', update);
+    category.addEventListener('change', update);
+    update();
+  }
+})();
