# Combine arrays
fruits := ["apple", "banana"]
vegetables := ["carrot", "broccoli"]
food := [...fruits, ...vegetables]
print("All food: " + to_string(food))

# Add elements while spreading
numbers := [2, 3, 4]
extended := [1, ...numbers, 5, 6]
print("Extended numbers: " + to_string(extended))

# Clone an array
original := [10, 20, 30]
clone := [...original]
print("Clone: " + to_string(clone))
