{
  "name": "kujolang-ai-site",
  "private": true,
  "version": "1.3.1",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "images:responsive": "node scripts/generate-responsive-images.mjs",
    "images:verify": "node scripts/verify-responsive-images.mjs",
    "icons:build": "node scripts/build-icons.mjs",
    "vendor:scramble": "scramble-decode copy assets/js/vendor",
    "social:cards": "bash scripts/render-social-cards.sh",
    "social:verify": "node scripts/verify-social-cards.mjs",
    "compare:generate": "node scripts/render-comparisons.mjs",
    "compare:check": "node scripts/render-comparisons.mjs --check",
    "compare:verify": "python3 scripts/verify-comparisons.py",
    "examples:generate": "node scripts/render-language-examples.mjs && python3 scripts/bundle-language-examples.py",
    "examples:check": "node scripts/render-language-examples.mjs --check && python3 scripts/bundle-language-examples.py --check",
    "examples:verify": "python3 scripts/verify-language-examples.py",
    "language:verify": "python3 scripts/verify-language-site.py",
    "guides:generate": "node scripts/render-language-guides.mjs",
    "guides:check": "node scripts/render-language-guides.mjs --check",
    "howl:pages:generate": "node scripts/render-language-howl.mjs",
    "howl:pages:check": "node scripts/render-language-howl.mjs --check",
    "seo:pages:verify": "python3 scripts/verify-language-seo.py",
    "workflows:generate": "node scripts/render-ai-workflows.mjs && node scripts/render-language-examples.mjs && node scripts/render-language-howl.mjs && python3 scripts/bundle-ai-workflows.py",
    "workflows:check": "node scripts/render-ai-workflows.mjs --check && python3 scripts/bundle-ai-workflows.py --check",
    "workflows:verify": "python3 scripts/verify-ai-workflows.py"
  },
  "dependencies": {
    "scramble-decode": "0.1.0"
  },
  "devDependencies": {
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5"
  },
  "engines": {
    "node": ">=22.23.4 <23 || >=24.22.1 <25 || >=26.12.1"
  }
}
